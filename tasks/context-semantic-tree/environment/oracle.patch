index 0000000000000000000000000000000000000000..2b2e999b2b4093e4b3b4f0f6407fbfef32d16b2d
--- /dev/null
+++ b/src/context/shared/ContextNumberUtils.ts
@@ -0,0 +1,7 @@
+const CONTEXT_NUMBER_SCALE = 10_000;
+
+export function roundContextNumber(value: number): number {
+  const rounded =
+    Math.round(value * CONTEXT_NUMBER_SCALE) / CONTEXT_NUMBER_SCALE;
+  return Object.is(rounded, -0) ? 0 : rounded;
+}
